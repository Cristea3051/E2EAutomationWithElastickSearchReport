<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Test Automation Suite" parallel="tests" thread-count="3" verbose="1">

    <listeners>
        <listener class-name="com.framework.listeners.TestListener"/>
    </listeners>

    <test name="Chromium Tests" parallel="methods" thread-count="2">
        <parameter name="browser" value="chromium"/>
        <classes>
            <class name="com.tests.ExampleTest"/>
        </classes>
    </test>

    <test name="Firefox Tests" parallel="methods" thread-count="2">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.tests.ExampleTest"/>
        </classes>
    </test>

    <test name="WebKit Tests" parallel="methods" thread-count="2">
        <parameter name="browser" value="webkit"/>
        <classes>
            <class name="com.tests.ExampleTest"/>
        </classes>
    </test>

</suite>
